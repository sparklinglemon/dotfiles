# Claude Code: keep portable config only; never commit credentials, history, sessions, caches, or logs.
stow/.claude/*
!stow/.claude/CLAUDE.md
!stow/.claude/statusline-command.sh

# tmux plugins are installed by tpm on first start.
stow/.config/tmux/plugins/

# fish rewrites this file with machine-local state.
stow/.config/fish/fish_variables
