stow/.config/gh/hosts.yml

# Pi: keep portable settings only; never commit auth, sessions, caches, installed packages, or model stores.
stow/.pi/agent/*
!stow/.pi/agent/settings.json

# Claude Code: keep portable config only; never commit credentials, history, sessions, caches, or logs.
stow/.claude/*
